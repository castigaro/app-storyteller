    <color name="primary_dark">#5D55A8</color>
    <color name="secondary">#A9A2E8</color>
    <!-- Toolbar bleibt dunkel, damit der weiße Titel darauf gut lesbar ist. -->
    <color name="toolbar_bg">#211D45</color>
